### 4.1 Default per_page = 50 -> 63 rows split over 2 pages
# Fixture: samples/pagination/obs_SP.POP.TOTL_9c_default_per_page.json
GET {{base}}/country/{{countries}}/indicator/SP.POP.TOTL?format=json&date={{years}}

